[Unit]
Description=farvardin CardDAV/CalDAV server
Documentation=https://github.com/1995parham-me/farvardin
After=network-online.target
Wants=network-online.target

[Service]
# systemd creates the user; packages need no install script.
DynamicUser=yes
ExecStart=/usr/bin/farvardin serve --config /etc/farvardin/config.toml
Restart=on-failure
RestartSec=5

# farvardin only needs its store, /var/lib/farvardin.
StateDirectory=farvardin
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# Small boards: keep the Go heap under the cgroup limit (see the README).
Environment=GOMEMLIMIT=200MiB
MemoryMax=256M

[Install]
WantedBy=multi-user.target
